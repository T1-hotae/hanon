rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // 관리자 = 이메일/비밀번호로 로그인한 사용자. 익명(학생)과 구분한다.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    match /categories/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /keywordPresets/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /faqEntries/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
      // 학생(로그인 사용자)은 조회수(viewCount)만 갱신할 수 있다.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']);
    }

    match /checklists/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /contacts/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 학과 목록. 상담사 연결 폼의 선택지로 쓰이므로 공개 읽기.
    match /departments/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin();
      // 학생(로그인 사용자)은 조회수(viewCount)만 갱신할 수 있다.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']);
    }

    match /inquiries/{inquiryId} {
      allow create: if
        request.resource.data.source in ['chat', 'phone'] &&
        request.resource.data.categoryId is string &&
        request.resource.data.keyword is string &&
        request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    // 실시간 채팅 대화. 학생은 본인(studentId == uid) 대화만, 관리자는 전체.
    match /conversations/{conversationId} {
      function ownsConversation() {
        return signedIn() && resource.data.studentId == request.auth.uid;
      }

      // 학생 식별정보 규칙(클라이언트 검증과 짝을 이루는 서버측 최소 방어선).
      // 학번은 숫자 9자리, 이름·학과는 길이만 확인한다(한글 문자클래스는 규칙에서 쓰지 않는다).
      function identityFields() {
        return ['studentName', 'studentNumber', 'studentDepartment', 'studentDepartmentId'];
      }

      function identityFilled(d) {
        return d.studentNumber.matches('^[0-9]{9}$')
          && d.studentName.size() >= 2 && d.studentName.size() <= 30
          && d.studentDepartment.size() >= 2 && d.studentDepartment.size() <= 30;
      }

      // AI 상담 대화는 식별정보가 비어 있는 것이 정상이다.
      // 상담사 대화는 별개의 새 대화로 만들어지며 생성 시점부터 식별정보가 채워진다.
      function identityBlank(d) {
        return d.studentName == '' && d.studentNumber == '' && d.studentDepartment == '';
      }

      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.studentName is string
        && request.resource.data.studentNumber is string
        && request.resource.data.studentDepartment is string
        && (identityBlank(request.resource.data) || identityFilled(request.resource.data));
      // 상담사(관리자)는 상담사 연결을 요청한 대화(needsHuman == true)만 읽을 수 있다.
      // AI 상담(needsHuman == false)은 DB 수준에서 상담사에게 노출되지 않는다.
      // (규칙은 필터가 아니므로, 관리자 앱 쿼리도 where('needsHuman','==',true)로 맞춰야 한다.)
      allow read: if (isAdmin() && resource.data.needsHuman == true) || ownsConversation();
      // 학생 앱은 식별정보를 create 시점에만 채우지만, update로 바꾸려는 경우에도 형식을 강제한다.
      // 읽음 처리·메시지 메타 갱신 등 식별정보를 건드리지 않는 update는 그대로 통과한다.
      allow update: if isAdmin()
        || (ownsConversation() && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(identityFields())
          || identityFilled(request.resource.data)
        ));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        function ownsParent() {
          return signedIn()
            && get(/databases/$(database)/documents/conversations/$(conversationId)).data.studentId == request.auth.uid;
        }

        // 상담사는 AI 자동응답(from == 'ai') 메시지를 읽을 수 없다. 학생은 본인 대화의 모든 메시지를 읽는다.
        // (관리자 앱 쿼리는 where('from','!=','ai')로 맞춰야 이 규칙과 충돌하지 않는다.)
        allow read: if (isAdmin() && resource.data.from != 'ai') || ownsParent();
        // 학생은 student/bot/ai 메시지만, 관리자는 admin 메시지만 생성.
        allow create: if
          (isAdmin() && request.resource.data.from == 'admin') ||
          (ownsParent() && request.resource.data.from in ['student', 'bot', 'ai']);
        allow update, delete: if isAdmin();
      }
    }
  }
}
